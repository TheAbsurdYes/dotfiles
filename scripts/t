#!/usr/bin/env bash

# Credit to ThePrimeagen

resolve_script_dir() {
    local source="${BASH_SOURCE[0]}"

    while [[ -L "$source" ]]; do
        local dir
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        [[ "$source" != /* ]] && source="$dir/$source"
    done

    cd -P "$(dirname "$source")" && pwd
}

normalize_path() {
    local path="$1"

    [[ -d "$path" ]] || return 1
    (
        cd "$path" && pwd -P
    )
}

path_in_list() {
    local needle="$1"
    shift

    local item
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done

    return 1
}

load_items() {
    local paths_file="$1"
    local path child
    local -a T_PATHS=()
    local -a configured_roots=()

    # shellcheck source=/dev/null
    source "$paths_file"

    for path in "${T_PATHS[@]}"; do
        path="$(normalize_path "$path")" || continue
        configured_roots+=("$path")
    done

    for path in "${configured_roots[@]}"; do
        if [[ "$path" == "$HOME/code" || "$path" == "$HOME/code/"* ]]; then
            while IFS= read -r child; do
                child="$(normalize_path "$child")" || continue

                if path_in_list "$child" "${configured_roots[@]}"; then
                    continue
                fi

                printf '%s\n' "$child"
            done < <(find "$path" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
        else
            printf '%s\n' "$path"
        fi
    done
}

paths_file="${T_PATHS_FILE:-$(resolve_script_dir)/.t-paths}"

if [[ $# -eq 1 ]]; then
    selected="$1"
else
    if [[ ! -f "$paths_file" ]]; then
        echo "Missing $paths_file. Define T_PATHS=(...) in it." >&2
        exit 1
    fi

    items="$(load_items "$paths_file" | awk '!seen[$0]++')"

    if [[ -z "$items" ]]; then
        echo "No valid directories found in $paths_file" >&2
        exit 1
    fi

    selected="$(printf '%s\n' "$items" | fzf)"
    [[ -z "$selected" ]] && exit 0
fi

dirname="$(basename "$selected" | sed 's/\./_/g')"

tmux switch-client -t "=$dirname"
if [[ $? -eq 0 ]]; then
    exit 0
fi

tmux new-session -c "$selected" -d -s "$dirname" && tmux switch-client -t "$dirname" || tmux new -c "$selected" -A -s "$dirname"
