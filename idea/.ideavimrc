" set number relativenumber
set surround
set ideajoin
set scrolloff=15
set sidescrolloff=15
set ignorecase smartcase
set clipboard+=unnamed
set visualbell
set noerrorbells
set highlightedyank
set showmode

let mapleader=" "

" system clipboard
" vmap <leader>y "+y
" vmap <leader>d "+d
" nmap <leader>y "+yy
" nmap <leader>p "+p
" nmap <leader>P "+P
" vmap <leader>p "+p
" vmap <leader>P "+P

set NERDTree
let g:NERDTreeMapActivateNode='l'
let g:NERDTreeMapJumpParent='h'

map gl $
map gh 0

" For insert mode, map ';;' to '<Esc>A;<Esc>'
nmap ;; A;<ESC>

" For insert mode, map ',,' to '<Esc>A,<Esc>'
nmap ,, A,<ESC>

nnoremap J mzJ`z
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzzzv
nnoremap N Nzzzv

vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

" Pane navigation
" nnoremap <A-h> <C-w>h
" nnoremap <A-l> <C-w>l
" nnoremap <A-k> <C-w>k
" nnoremap <A-j> <C-w>j

vnoremap > >gv
vnoremap < <gv

" Jump between methods
nmap [[ <Action>(MethodUp)
nmap ]] <Action>(MethodDown)

map <leader><leader> <Action>(SearchEverywhere)
map <leader>o <Action>(GotoClass)
map <leader>a <Action>(GotoAction)
map <leader>f <Action>(GotoFile)
map <leader>w <Action>(GotoSymbol)
map <leader>s <Action>(FileStructurePopup)
map <leader>d <Action>(ShowErrorDescription)
map <leader>e <Action>(RecentFiles)

map <leader>rn <Action>(RenameElement)

map <leader>t <Action>(Refactorings.QuickListPopupAction)

map <D-k> <Action>(EditorSelectWord) 
map <D-j> <Action>(EditorUnSelectWord) 

map <Leader>1 <action>(SelectInProjectView)

map <CR> <action>(EditorSelectWord)
xmap <TAB> <action>(EditorSelectWord)
xmap <S-TAB> <action>(EditorUnSelectWord)

nmap gr <action>(FindUsages)
nmap gi <action>(GotoImplementation)

nmap <C-j> <action>(NextOccurence)
nmap <C-K> <action>(PreviousOccurence)

nmap ]d <action>(GotoNextError)
nmap [d <action>(GotoPreviousError)
